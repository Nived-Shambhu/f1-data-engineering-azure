                    "transformations": [
                        {
                            "name": "flatten1"
                        }
                    ],
                    "scriptLines": [
                        "source(output(",
                        "          MRData as (RaceTable as (Races as (Circuit as (Location as (country as string, lat as double, locality as string, long as double), circuitId as string, circuitName as string, url as string), FirstPractice as (date as date, time as string), Qualifying as (date as date, time as string), SecondPractice as (date as date, time as string), Sprint as (date as date, time as string), SprintQualifying as (date as date, time as string), ThirdPractice as (date as date, time as string), date as date, raceName as string, round as short, season as short, time as string, url as string)[], season as short), limit as short, offset as boolean, series as string, total as short, url as string, xmlns as string)",
                        "     ),",
                        "     allowSchemaDrift: true,",
                        "     validateSchema: false,",
                        "     inferDriftedColumnTypes: true,",
                        "     ignoreNoFilesFound: false,",
                        "     documentForm: 'documentPerLine') ~> source1",
                        "source1 foldDown(unroll(MRData.RaceTable.Races),",
                        "     mapColumn(",
                        "          Season = MRData.RaceTable.season,",
                        "          Round = MRData.RaceTable.Races.round,",
                        "          {Race Name} = MRData.RaceTable.Races.raceName,",
                        "          {Circuit ID} = MRData.RaceTable.Races.Circuit.circuitId,",
                        "          {Circuit Name} = MRData.RaceTable.Races.Circuit.circuitName,",
                        "          Latitude = MRData.RaceTable.Races.Circuit.Location.lat,",
                        "          Longitude = MRData.RaceTable.Races.Circuit.Location.long,",
                        "          City = MRData.RaceTable.Races.Circuit.Location.locality,",
                        "          Country = MRData.RaceTable.Races.Circuit.Location.country,",
                        "          {Race Date} = MRData.RaceTable.Races.date,",
                        "          {Race Time} = MRData.RaceTable.Races.time",
                        "     ),",
                        "     skipDuplicateMapInputs: false,",
                        "     skipDuplicateMapOutputs: false) ~> flatten1",
                        "flatten1 sink(allowSchemaDrift: true,",
                        "     validateSchema: false,",
                        "     umask: 0022,",
                        "     preCommands: [],",
                        "     postCommands: [],",
                        "     skipDuplicateMapInputs: true,",
                        "     skipDuplicateMapOutputs: true) ~> sink1"
                    ]
                }
            },
